# ── Copiez en `.env` et remplissez ─────────────────────────────────────────

# URL publique du site (ex. https://relanceo.fr en prod, http://localhost:3000 en dev)
BASE_URL=http://localhost:3000
PORT=3000

# Secret pour signer les cookies de session (changez-le !)
SESSION_SECRET=changez-moi-par-un-secret-long-et-aleatoire

# ── Stripe (paiements réels). LAISSER VIDE = mode simulation (démo locale) ──
# Créez un compte sur dashboard.stripe.com puis des Produits/Prix.
STRIPE_SECRET_KEY=
# IDs des Prix (prix_...) créés dans Stripe pour Essentiel 9,99 et Pro 19,99
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
# Clé de webhook (Stripe → CLI `stripe listen`) pour mettre à jour les abonnements
STRIPE_WEBHOOK_SECRET=

# ── Envoi des emails. LAISSER VIDE = écrit dans ./outbox (simulation) ──────
RESEND_API_KEY=
EMAIL_FROM=Tresoleo <relances@tresoleo.app>
# Délais de relance par défaut (jours) — réglables par l'utilisateur
DEFAULT_DELAYS=7,15,30
